# Use Node 24: node --env-file=.env.local apps/api/dist/demo/server.js
# Keep the actual .env.local and private data out of Git.
NODE_ENV=production
HOST=127.0.0.1
PORT=4173
CODE_TAPE_DATA_DIR=.code-tape-data
CODE_TAPE_PUBLIC_BASE_URL=https://codetape.example.com
CODE_TAPE_ALLOWED_ORIGINS=https://codetape.example.com
CODE_TAPE_AUTH_SECRET=

# Frontend switches: pass as build environment or put ONLY these in apps/web/.env.local.
# Vite does not automatically read the API's repository-root .env.local.
# Never prefix a server secret with VITE_: Vite values are public client configuration.
VITE_CODE_TAPE_COLLABORATION_ENABLED=true
VITE_CODE_TAPE_EVENT_TIMELINE_ENABLED=true
VITE_CODE_TAPE_SUBTITLE_ANCHORS_ENABLED=true
# Opt-in browser diagnostics: allowlisted IDs/numbers only, never source or credentials.
VITE_CODE_TAPE_DEBUG_ENABLED=false
